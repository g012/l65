cpu = require 'z80'
setmetatable(_ENV, cpu)

zx = {
    ROM                    = 0x0000,
    RAM                    = 0x4000,
    SCREEN                 = 0x4000,
    BITMAP                 = 0x4000,
    ATTRIBUTES             = 0x5800,
    PRINTER_BUFFER         = 0x5b00,
    SYSTEM_VARIABLES       = 0x5c00,
    BASIC_RAM              = 0x5ccb,

    SCREEN_WIDTH           = 256,
    SCREEN_HEIGHT          = 192,
    SCREEN_COLUMNS         = 32,
    SCREEN_ROWS            = 24,
    CHARACTER_WIDTH        = 8,
    CHARACTER_HEIGHT       = 8,
    BITMAP_SIZE            = 0x1800,
    ATTRIBUTES_SIZE        = 0x0300,
    SCREEN_SIZE            = 0x1b00,

    ULA_PORT               = 0xfe,
    KEMPSTON_PORT          = 0x1f,

    BLACK                  = 0,
