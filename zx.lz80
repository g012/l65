    -- Standard 48K ROM entry points.
    ROM_PRINT_CHAR         = 0x0010,
    ROM_BEEPER             = 0x03b5,
    ROM_CLS                = 0x0daf,

    -- Standard 48K system variables.
    KSTATE                 = 0x5c00,
