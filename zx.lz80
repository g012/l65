    FLAGS2                 = 0x5c6a,
    DF_SZ                  = 0x5c6b,
    S_TOP                  = 0x5c6c,
    OLDPPC                 = 0x5c6e,
    OSPCC                  = 0x5c70,
    FLAGX                  = 0x5c71,
    STRLEN                 = 0x5c72,
