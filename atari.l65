do
    local symbols = cpu.symbols
    for k,v in pairs(atari) do symbols[k] = v end
end

-- Declare a single-segment DOS 2 binary load file. The regular writebin()
-- path adds the XEX segment header and RUNAD record after linking.
atari.xex = function(t)
    if type(t) == 'number' then t = { start=t } end
    t = t or {}
    assert(#cpu.locations == 0, "atari.xex must be declared before any locations")
    local start = t.start or 0x2000
    assert(math.type(start) == 'integer' and start >= 0 and start <= 0xffff,
        "invalid XEX load address")
    if t.finish then
        assert(math.type(t.finish) == 'integer' and t.finish >= start and t.finish <= 0xffff,
            "invalid XEX end address")
    end

    program = location{start, t.finish, name=t.name or 'program'}
    local run = t.run or 'main'
    cpu.bin_finalizer = function(bin)
        assert(#bin > 0, "cannot write an empty XEX segment")
        local finish = start + #bin - 1
        assert(finish <= 0xffff, "XEX segment exceeds the 6502 address space")
        local run_address = op_resolve(run)
        assert(run_address >= 0 and run_address <= 0xffff, "invalid XEX run address")

        local header = { 0xff, 0xff, start&0xff, start>>8, finish&0xff, finish>>8 }
        for i=#header,1,-1 do table.insert(bin, 1, header[i]) end
        bin[#bin+1] = RUNAD&0xff
        bin[#bin+1] = RUNAD>>8
        bin[#bin+1] = (RUNAD+1)&0xff
        bin[#bin+1] = (RUNAD+1)>>8
        bin[#bin+1] = run_address&0xff
        bin[#bin+1] = run_address>>8
    end
    return program
end

-- Emit a CIO call. X and Y have the usual CIO return values afterwards.
atari.cio = function(t)
    assert(type(t) == 'table' and t.command, "atari.cio requires a command")
    local channel = t.channel or 0
    assert(math.type(channel) == 'integer' and channel >= 0 and channel < 8,
        "invalid CIO channel")
    ldx #channel*IOCBSZ
    lda #t.command sta ICCOM,x
    if t.buffer then
        lda #op_resolve(t.buffer)&0xff sta ICBAL,x
        lda #op_resolve(t.buffer)>>8 sta ICBAH,x
    end
    if t.length then
        lda #op_resolve(t.length)&0xff sta ICBLL,x
        lda #op_resolve(t.length)>>8 sta ICBLH,x
    end
    if t.aux1 then lda #t.aux1 sta ICAX1,x end
    if t.aux2 then lda #t.aux2 sta ICAX2,x end
    jsr CIOV
end

atari.put = function(buffer, length, channel)
    atari.cio{ command=PUTCHR, buffer=buffer, length=length, channel=channel }
end

atari.wait_vblank = function()
    local wait = label()
    lda RTCLOK+2
    cmp RTCLOK+2
    beq wait
end
